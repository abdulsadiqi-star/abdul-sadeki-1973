# Example TLS reverse proxy (Caddy) for production. Replace the domain.
# Set TRUSTED_PROXY_HOPS=1 and APP_URL=https://tamashagah.example.com in the app environment.
tamashagah.example.com {
	encode zstd gzip

	# Large uploads (tus PATCH requests) and long HLS reads: no request-size cap, generous timeouts.
	request_body {
		max_size 4GB
	}
	reverse_proxy web:3000 {
		flush_interval -1
		transport http {
			read_timeout 10m
			write_timeout 10m
		}
	}
}
