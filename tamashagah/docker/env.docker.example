# Optional overrides for the web and worker containers  ->  copy to .env.docker (git-ignored, chmod 600).
# Everything here wins over docker/defaults.env. Restart with: docker compose --profile app up -d
# Secrets that Compose wires itself (DATABASE_URL, SESSION_SECRET, S3 keys) come from .env and are not read from this file.

# --- Real e-mail delivery (instead of the bundled Mailpit inbox) ---------------------------------
# MAIL_TRANSPORT=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false          # true = implicit TLS (port 465); false = STARTTLS when the server offers it
# SMTP_USER=postmaster@example.com
# SMTP_PASSWORD=CHANGE_ME

# --- External S3-compatible storage (instead of the bundled RustFS) ------------------------------
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true   # false for virtual-hosted style (AWS S3)
# (bucket and access keys: S3_BUCKET / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY in .env)
# MEDIA_DELIVERY=redirect    # 302 to short-lived presigned URLs instead of proxying bytes through the app

# --- Limits and processing -----------------------------------------------------------------------
# UPLOAD_MAX_BYTES=2147483648
# UPLOAD_DAILY_QUOTA_BYTES=10737418240
# UPLOAD_MAX_PER_DAY=50
# TRANSCODE_PRESET=veryfast
# HLS_SEGMENT_SECONDS=6
# KEEP_ORIGINAL_SOURCE=true
