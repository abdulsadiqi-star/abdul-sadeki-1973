# Non-secret defaults for the services bundled in docker-compose.yml (web + worker containers).
# Do not edit — put overrides in .env.docker (see docker/env.docker.example).
STORAGE_DRIVER=s3
S3_ENDPOINT=http://objectstore:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
REDIS_URL=redis://redis:6379
MAIL_TRANSPORT=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
