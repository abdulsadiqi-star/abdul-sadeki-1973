# =============================================================================
# تماشاگاه — environment variables
# Copy to .env (or run `pnpm setup:env`, which also generates strong secrets).
# NEVER commit .env. Secrets below are placeholders.
# =============================================================================

# --- Application --------------------------------------------------------------
# Public base URL (absolute links in e-mails, origin checks). Must be https:// in production.
APP_URL=http://localhost:3000
# Only for local production-mode testing over http (e2e). Never in real deployments.
# ALLOW_INSECURE_HTTP=true
# Comma-separated extra origins allowed to call mutating endpoints (usually empty).
# TRUSTED_ORIGINS=
# Number of reverse proxies in front of the app you control (reads X-Forwarded-For). 0 = ignore the header.
TRUSTED_PROXY_HOPS=0
LOG_LEVEL=info

# --- Database (PostgreSQL 16+) ------------------------------------------------
# docker compose: user/db `tamashagah`; password comes from POSTGRES_PASSWORD below.
DATABASE_URL=postgresql://tamashagah:CHANGE_ME@localhost:5432/tamashagah
# Optional: dedicated database for integration tests (default: DATABASE_URL with "_test" appended).
# DATABASE_URL_TEST=postgresql://tamashagah:CHANGE_ME@localhost:5432/tamashagah_test
DATABASE_POOL_MAX=10

# --- Redis (rate limiting + BullMQ) -------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# --- Security -----------------------------------------------------------------
# >= 32 random chars:  openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
SESSION_TTL_DAYS=30
SESSION_ABSOLUTE_TTL_DAYS=90

# --- Object storage -----------------------------------------------------------
# fs  = local disk (development, tests, single node)
# s3  = any S3-compatible service (MinIO, AWS S3, Ceph, Arvan, Liara, ...)
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=.data/storage
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=tamashagah
# S3_ACCESS_KEY_ID=CHANGE_ME
# S3_SECRET_ACCESS_KEY=CHANGE_ME
# S3_FORCE_PATH_STYLE=true
# proxy = stream media through the app; redirect = 302 to short-lived presigned URLs (s3 only)
MEDIA_DELIVERY=proxy

# --- Uploads ------------------------------------------------------------------
UPLOAD_MAX_BYTES=2147483648
UPLOAD_DAILY_QUOTA_BYTES=10737418240
UPLOAD_MAX_PER_DAY=50
UPLOAD_STALE_HOURS=48

# --- Video processing (worker) ------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WORKER_CONCURRENCY=1
TRANSCODE_PRESET=veryfast
HLS_SEGMENT_SECONDS=6
KEEP_ORIGINAL_SOURCE=true
# WORKER_TMP_DIR=/var/tmp/tamashagah

# --- E-mail -------------------------------------------------------------------
# console = log messages (dev only, links contain secrets) | file = JSON files in MAIL_FILE_DIR | smtp = real delivery
MAIL_TRANSPORT=console
MAIL_FROM="تماشاگاه <no-reply@example.com>"
MAIL_FILE_DIR=.data/mailbox
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# --- Docker Compose only ------------------------------------------------------
# POSTGRES_PASSWORD=CHANGE_ME
# MINIO_ROOT_USER=CHANGE_ME
# MINIO_ROOT_PASSWORD=CHANGE_ME_at_least_8_chars
