{
  "name": "tamashagah",
  "version": "0.1.0",
  "private": true,
  "description": "تماشاگاه — پلتفرم اشتراک‌گذاری ویدیوی فارسی (RTL) با آپلود، پردازش HLS، استودیوی سازندگان و آمار",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "dev:worker": "tsx watch --env-file-if-exists=.env worker/index.ts",
    "build": "prisma generate && next build",
    "build:worker": "esbuild ./worker/index.ts ./scripts/promote-user.ts ./scripts/check-storage.ts --bundle --platform=node --format=esm --target=node22 --packages=external --sourcemap --tsconfig=tsconfig.json --outdir=dist --outbase=. --out-extension:.js=.mjs",
    "start": "next start",
    "start:worker": "node --enable-source-maps dist/worker/index.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "seed:media": "tsx --env-file-if-exists=.env scripts/seed-media.ts",
    "seed:bulk": "tsx --env-file-if-exists=.env scripts/bulk-seed.ts",
    "postinstall": "prisma generate",
    "setup:env": "node scripts/init-env.mjs",
    "test:components": "vitest run --project component",
    "audit:security": "node scripts/audit-security.mjs",
    "check:storage": "tsx --env-file-if-exists=.env scripts/check-storage.ts",
    "user:promote": "tsx --env-file-if-exists=.env scripts/promote-user.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "esbuild",
      "unrs-resolver",
      "sharp",
      "msgpackr-extract"
    ],
    "overrides": {
      "mysql2": ">=3.23.1",
      "deepmerge-ts": ">=8.0.0"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/lib-storage": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@hookform/resolvers": "^5.9.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tanstack/react-query": "^5.104.1",
    "@tus/file-store": "^2.1.1",
    "@tus/s3-store": "^2.0.7",
    "@tus/server": "^2.4.5",
    "bullmq": "^6.3.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hls.js": "^1.7.3",
    "ioredis": "^6.0.0",
    "jalaali-js": "^2.0.1",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.0",
    "pino": "^10.4.0",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tus-js-client": "^4.3.1",
    "vazirmatn": "^33.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jalaali-js": "^1.2.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "dotenv": "^18.0.7",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.2",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  }
}
