# ---------------------------------------------------------------
# تنظیمات فروشگاه — این فایل را با نام .env کپی کنید و مقادیر را پر کنید.
# فایل .env هرگز نباید در گیت‌هاب قرار بگیرد (در .gitignore آمده است).
# ---------------------------------------------------------------

# development یا production
NODE_ENV=production
PORT=3000

# آدرس عمومی سایت (برای بازگشت از درگاه پرداخت). بدون / در انتها.
PUBLIC_URL=https://shop.example.ir

# رمز ورود به پنل مدیریت (حداقل ۱۰ کاراکتر)
ADMIN_PASSWORD=

# یک رشته تصادفی طولانی؛ برای ساختن آن: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# محل ذخیره پایگاه داده و عکس‌ها (پیش‌فرض: shop/data)
# DATA_DIR=/var/lib/kalano

# اگر سایت پشت Nginx یا سرویس ابری است، true کنید تا IP واقعی کاربران خوانده شود
TRUST_PROXY=false

# --- درگاه پرداخت زرین‌پال ---
# مرچنت کد ۳۶ کاراکتری از پنل زرین‌پال
ZARINPAL_MERCHANT_ID=
# برای آزمایش با درگاه آزمایشی زرین‌پال true کنید
ZARINPAL_SANDBOX=false

# --- پیامک کاوه‌نگار (کد ورود) ---
KAVENEGAR_API_KEY=
# نام قالب «تأیید» که در پنل کاوه‌نگار ساخته‌اید (متن قالب باید %token را داشته باشد)
KAVENEGAR_TEMPLATE=verify
